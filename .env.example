# Required in production
NODE_ENV=production
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
SESSION_SECRET=replace-with-a-long-random-secret
LF_FIELD_ENCRYPTION_KEY=replace-with-a-separate-long-random-secret

# Private Cloudflare R2 object storage (server-side only)
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=little-feet-private

# Optional integrations
# Email delivery: configure either SMTP (recommended for an existing Zoho mailbox)
# or the HTTPS email API fallback. Never commit real mailbox passwords/API keys.
LF_EMAIL_FROM=
LF_EMAIL_FROM_NAME=Little Feet
LF_SMTP_HOST=smtp.zoho.com
LF_SMTP_PORT=465
LF_SMTP_USERNAME=
LF_SMTP_PASSWORD=
LF_EMAIL_API_KEY=
LF_EMAIL_API_URL=https://api.resend.com/emails

# Optional social sign-in providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=

# Inbound email receiving via Resend forwarding
# Use the inbound domain shown in Resend Receiving Emails, without the @.
# Webhook endpoint: https://littlefeet.co.za/api/email/inbound/resend
LF_INBOUND_EMAIL_DOMAIN=
LF_INBOUND_EMAIL_API_KEY=
LF_INBOUND_WEBHOOK_SECRET=

LF_PAYMENT_WEBHOOK_SECRET=
LF_MONITORING_DSN=

# One-time production owner reset. Keep the password/PIN only in the hosting
# provider's protected environment settings. Disable and remove the PIN after
# the migration has completed successfully.
LF_OWNER_RESET_ALL_ACCOUNTS=0
LF_OWNER_ACCOUNT_RESET_ID=
LF_OWNER_ADMIN_USERNAME=
LF_OWNER_ADMIN_PIN=
LF_OWNER_ADMIN_NAME=
LF_OWNER_SCHOOL_NAME=

# Optional capacity controls
PG_POOL_MAX=8
LF_MAX_API_BODY_MB=8
LF_API_MUTATION_RATE_LIMIT=240
LF_API_READ_RATE_LIMIT=1200
